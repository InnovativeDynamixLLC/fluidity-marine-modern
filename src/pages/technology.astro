            <text x="716" y="165" text-anchor="middle" fill="#00F0FF" font-size="8" font-weight="700" font-family="Inter">2</text>
            <circle cx="716" cy="176" r="9" fill="rgba(0,240,255,0.2)" stroke="#00F0FF" stroke-width="1.5"/>
            <text x="716" y="179" text-anchor="middle" fill="#00F0FF" font-size="8" font-weight="700" font-family="Inter">3</text>
            <circle cx="716" cy="190" r="9" fill="rgba(255,184,0,0.25)" stroke="#FFB800" stroke-width="1.5"/>
