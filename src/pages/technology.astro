---
import Layout from '../layouts/Layout.astro';
---

<Layout title="TVC Technology | Fluidity Marine — Thrust Vector Control">
  <main class="page">
    <!-- Hero -->
    <section class="tech-hero animate-in">
      <h1 class="page-title">
        Thrust Vector Control<br />
        <span class="electric-text">TVC</span>
      </h1>
      <p class="page-subtitle">
        The culmination of digital fluid dynamic control. TVC replaces every mechanical control surface 
        on a marine vessel with directed fluid power. Seven synchronized jets. Two thousand decisions per second. 
        <strong>Zero rudders.</strong> Pure fluid intelligence.
      </p>
    </section>

    <!-- TVC Diagram -->
