            <circle cx="716" cy="204" r="9" fill="rgba(0,240,255,0.2)" stroke="#00F0FF" stroke-width="1.5"/>
            <text x="716" y="207" text-anchor="middle" fill="#00F0FF" font-size="8" font-weight="700" font-family="Inter">5</text>
            <circle cx="716" cy="218" r="9" fill="rgba(0,240,255,0.2)" stroke="#00F0FF" stroke-width="1.5"/>
            <text x="716" y="221" text-anchor="middle" fill="#00F0FF" font-size="8" font-weight="700" font-family="Inter">6</text>
            <circle cx="716" cy="232" r="9" fill="rgba(0,240,255,0.2)" stroke="#00F0FF" stroke-width="1.5"/>
